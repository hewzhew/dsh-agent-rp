@@ -0,0 +1,59 @@
+import { Context } from '@deepseek-ai/cordis'
+import SessionStore from '@deepseek-ai/dsh-session'
+import { describe, expect, it } from 'vitest'
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    /** Required state owned by a repository-external fixture plugin. */
+    'fixture/required': { value: number }
+  }
+}
+
+describe('external session event type registration', () => {
+  it('recognizes a type only while its effect-owned package registration is live', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    let disposeFirst!: () => void
+    let disposeSecond!: () => void
+    try {
+      const first = await ctx.plugin(Object.assign((inner: Context) => {
+        disposeFirst = inner.sessions.registerEventType('fixture/required', '@fixture/session-events')
+      }, { inject: ['sessions'] }))
+      const second = await ctx.plugin(Object.assign((inner: Context) => {
+        disposeSecond = inner.sessions.registerEventType('fixture/required', '@fixture/session-events')
+      }, { inject: ['sessions'] }))
+
+      expect(ctx.sessions.recognizesEventType('turn/start')).toBe(true)
+      expect(ctx.sessions.recognizesEventType('fixture/required')).toBe(true)
+      disposeFirst()
+      expect(ctx.sessions.recognizesEventType('fixture/required')).toBe(true)
+      await first.dispose()
+      await second.dispose()
+      expect(ctx.sessions.recognizesEventType('fixture/required')).toBe(false)
+      disposeSecond()
+    } finally {
+      await ctx.fiber.dispose()
+    }
+  })
+
+  it('rejects first-party claims, invalid package names, and conflicting owners', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    try {
+      expect(() => ctx.sessions.registerEventType('turn/start', '@fixture/session-events'))
+        .toThrow(/owned by this Harness build/u)
+      expect(() => ctx.sessions.registerEventType('fixture/required', ''))
+        .toThrow(/non-empty trimmed string/u)
+      expect(() => ctx.sessions.registerEventType('fixture/required', ' padded '))
+        .toThrow(/non-empty trimmed string/u)
+
+      const dispose = ctx.sessions.registerEventType('fixture/required', '@fixture/session-events')
+      expect(() => ctx.sessions.registerEventType('fixture/required', '@other/session-events'))
+        .toThrow(/already registered by "@fixture\/session-events"/u)
+      dispose()
+      expect(ctx.sessions.recognizesEventType('fixture/required')).toBe(false)
+    } finally {
+      await ctx.fiber.dispose()
+    }
+  })
+})
