{
  "name": "@hewzhew/dsh-agent-rp",
  "version": "0.0.0-alpha-dev",
  "private": true,
  "description": "Native roleplay runtime and SillyTavern compatibility plugin for DeepSeek Harness.",
  "license": "MIT",
  "author": "Ocheron",
  "homepage": "https://github.com/hewzhew/dsh-agent-rp#readme",
  "bugs": {
    "url": "https://github.com/hewzhew/dsh-agent-rp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hewzhew/dsh-agent-rp.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "roleplay",
    "sillytavern"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "dsh-agent-rp-repair-session": "./lib/repair-session.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./extension/v0": {
      "types": "./lib/extension-v0.d.ts",
      "import": "./lib/extension-v0.js"
    },
    "./client-extension/v0": {
      "types": "./lib/client-extension-v0.d.ts",
      "import": "./lib/client-extension-v0.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "lib/index.js",
    "lib/extension-v0.js",
    "lib/extension-v0.d.ts",
    "lib/client-extension-v0.js",
    "lib/client-extension-v0.d.ts",
    "lib/repair-session.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "docs",
    "preset"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-agent-presets",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "audit:card": "tsdown scripts/audit-card-compat.ts --no-config --format esm --platform node --target es2024 --out-dir .audit-dist --clean && node .audit-dist/audit-card-compat.mjs",
    "audit:experience": "tsdown scripts/audit-roleplay-experience.ts --no-config --format esm --platform node --target es2024 --out-dir .audit-dist --clean && node .audit-dist/audit-roleplay-experience.mjs",
    "audit:preset": "tsdown scripts/audit-preset-compat.ts --no-config --format esm --platform node --target es2024 --out-dir .audit-dist --clean && node .audit-dist/audit-preset-compat.mjs",
    "audit:turn": "tsdown scripts/audit-roleplay-turn.ts --no-config --format esm --platform node --target es2024 --out-dir .audit-dist --clean && node .audit-dist/audit-roleplay-turn.mjs",
    "benchmark:charx": "tsdown benchmarks/charx-media.ts --no-config --format esm --platform node --target es2024 --out-dir .benchmark-dist --clean && node .benchmark-dist/charx-media.mjs",
    "benchmark:compat": "tsdown benchmarks/heavy-card.ts --no-config --format esm --platform node --target es2024 --out-dir .benchmark-dist --clean && node .benchmark-dist/heavy-card.mjs",
    "generate:tavern-vendor": "node scripts/generate-tavern-vendor-sources.mjs",
    "check:tavern-vendor": "node scripts/generate-tavern-vendor-sources.mjs --check",
    "check:dsh-alpha-source": "node scripts/dsh-alpha-dev.mjs verify",
    "check:release": "node scripts/check-prerelease-package.mjs",
    "clean:generated": "tsx scripts/clean-generated.ts",
    "smoke:compat": "tsdown --config tsdown.smoke.config.ts && node .smoke-dist/smoke-card-compat.mjs",
    "build": "tsdown",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "check:published-imports": "node scripts/check-published-imports.mjs && tsc -p tsconfig.published-client-extension.json && tsdown fixtures/published-client-extension-consumer.ts --no-config --format cjs --platform browser --target es2024 --out-dir .test-dist/published-client-extension --clean && node scripts/check-published-client-extension.mjs",
    "prepack": "pnpm run check:tavern-vendor && pnpm run build && pnpm run check:published-imports && pnpm run check:release",
    "test": "node scripts/run-source-tests.mjs all",
    "test:external-window": "node scripts/run-source-tests.mjs external-window",
    "test:http": "node scripts/run-source-tests.mjs http",
    "test:character-delete": "node scripts/run-source-tests.mjs character-delete",
    "test:smoke": "node scripts/run-source-tests.mjs smoke",
    "test:session-launch": "node scripts/run-source-tests.mjs session-launch",
    "test:turn-audit": "node scripts/run-source-tests.mjs turn-audit",
    "test:turn-recovery": "node scripts/run-source-tests.mjs turn-recovery",
    "test:provider-seam": "node scripts/run-source-tests.mjs provider-seam",
    "test:focused": "node scripts/run-source-tests.mjs focused",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-rc.1",
